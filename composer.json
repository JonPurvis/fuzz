{
    "name": "jonpurvis/fuzz",
    "description": "Coverage-guided fuzz testing for PestPHP",
    "keywords": [
        "php",
        "framework",
        "pest",
        "unit",
        "test",
        "testing",
        "plugin",
        "fuzz",
        "fuzzing"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Jon Purvis",
            "homepage": "https://jonathanpurvis.co.uk"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/serializable-closure": "^2.0",
        "nikic/php-fuzzer": "^0.0.11",
        "pestphp/pest-plugin": "^4.0 || ^5.0",
        "symfony/process": "^7.0|^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "pestphp/pest": "^4.0 || ^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0 || ^5.0",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.5",
        "symfony/var-dumper": "^7.0 || ^8.0"
    },
    "conflict": {
        "pestphp/pest": "<4.0.0"
    },
    "autoload": {
        "psr-4": {
            "Fuzz\\": "src/"
        },
        "files": [
            "src/Autoload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Fixtures\\": "tests/Fixtures/"
        }
    },
    "bin": [
        "bin/fuzz-worker.php"
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": [
            "pint --parallel",
            "rector"
        ],
        "refactor": "rector",
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run"
        ],
        "test:refactor": "rector --dry-run",
        "test:unit": "pest --parallel --coverage",
        "test:types": "phpstan",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ]
    },
    "extra": {
        "pest": {
            "plugins": [
                "Fuzz\\Plugin"
            ]
        }
    }
}
