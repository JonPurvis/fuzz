{
    "name": "jonpurvis/fuzz-poc",
    "private": true,
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "jonpurvis/fuzz": "*@dev",
        "pestphp/pest": "^5.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
